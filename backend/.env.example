# Copy to backend/.env and fill in. Never commit backend/.env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HERE Geocoding & Search v7 + Routing v8
HERE_API_KEY=

# Gross vehicle weight sent to the router = load + tare (spec D13). Rules use the load as entered.
TRUCK_TARE_LB=35000

# Internal Flask risk engine
RISK_ENGINE_URL=http://127.0.0.1:5001
RISK_ENGINE_TOKEN=change-me-shared-secret
